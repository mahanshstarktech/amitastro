{
  "name": "amitastro-server",
  "version": "1.0.1",
  "description": "Backend API & WebSockets for Amit Astro Astrology Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "make-admin": "tsx src/scripts/makeAdmin.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:realtime": "vitest run tests/realtime",
    "test:security": "vitest run tests/security",
    "test:database": "vitest run tests/database",
    "test:llm": "vitest run tests/llm",
    "test:coverage": "vitest run --coverage",
    "test:perf": "NODE_ENV=test tsx tests/perf/loadTest.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "autocannon": "^8.0.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
