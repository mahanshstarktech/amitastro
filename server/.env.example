# Server Environment Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://nakshaktram.pages.dev

# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================
# Leave empty for zero-setup local SQLite (server/data/nakshaktram.db)
# Or paste your cloud PostgreSQL connection string (Supabase / Neon / Render Postgres / AWS RDS):
# Example: postgresql://postgres.abc:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ==========================================
# 2. SECURITY & AUTH
# ==========================================
JWT_SECRET=super_secret_astrology_jwt_token_key_change_in_prod
ASTROLOGER_ADMIN_PIN=1108
ASTROLOGER_PHONE=+919876543210

# ==========================================
# 3. REAL NOTIFICATIONS (Telegram Bot)
# ==========================================
# Free instant alerts straight to Amit Soni's Telegram:
# Create bot via @BotFather on Telegram to get token, get chat_id via @userinfobot
ASTROLOGER_TELEGRAM_BOT_TOKEN=
ASTROLOGER_TELEGRAM_CHAT_ID=

# ==========================================
# 4. REAL SMS OTP (Twilio / MSG91)
# ==========================================
# Options: 'console' (dev logs to terminal) | 'twilio' | 'msg91'
SMS_PROVIDER=console

# If using Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# If using MSG91:
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ==========================================
# 5. REAL PAYMENT & UPI INTEGRATION
# ==========================================
MERCHANT_UPI_ID=amitsoni@okhdfcbank
MERCHANT_NAME=Amit Soni Jyotish
